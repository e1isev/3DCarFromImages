# Copy this file to .env and fill in your values.

# Quality preset: fast | high | ultra
CAR2ASSET_QUALITY=high

# Backend: triposr | stable-fast-3d | hunyuan3d
CAR2ASSET_BACKEND=hunyuan3d

# Output mode: realistic | cartoon | both
CAR2ASSET_MODE=both

# Hugging Face token (for gated model downloads)
HF_TOKEN=

# Device: cuda | cpu  (cuda recommended; cpu is very slow)
CAR2ASSET_DEVICE=cuda

# Blender executable path (required for FBX export and cartoon shader)
BLENDER_PATH=/usr/bin/blender

# Hunyuan3D model location: a HF repo id, or a local directory if you pre-downloaded
# the weights with `huggingface-cli download` (recommended — see README "Hunyuan3D"
# section; from_pretrained does not always auto-fetch from the Hub).
HUNYUAN3D_SHAPE_MODEL_PATH=tencent/Hunyuan3D-2mv
HUNYUAN3D_TEXTURE_MODEL_PATH=tencent/Hunyuan3D-2
