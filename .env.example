# Copy this file to .env and fill in your values.

# Quality preset: fast | high | ultra
CAR2ASSET_QUALITY=high

# Backend: triposr | stable-fast-3d | hunyuan3d
CAR2ASSET_BACKEND=hunyuan3d

# Output mode: realistic | cartoon | both
CAR2ASSET_MODE=both

# Hugging Face token (for gated model downloads)
HF_TOKEN=

# Device: cuda | cpu  (cuda recommended; cpu is very slow)
CAR2ASSET_DEVICE=cuda

# Blender executable path (required for FBX export and cartoon shader)
BLENDER_PATH=/usr/bin/blender
